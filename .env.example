POSTGRES_DB=codeflowatlas
POSTGRES_USER=codeflowatlas
POSTGRES_PASSWORD=change_this_local_password
API_PORT=8000
WEB_PORT=3000
APP_PUBLIC_URL=http://127.0.0.1:3000
COOKIE_SECURE=false

# Replace these placeholders before starting the API.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
OAUTH_STATE_SECRET=replace-with-a-long-random-secret

SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
